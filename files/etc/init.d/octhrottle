#!/bin/sh /etc/rc.common
# Thermal auto-throttle service (off by default; toggled from the OC panel).
START=95
STOP=10

start() {
	pgrep -f '/opt/bench/throttled.sh' >/dev/null 2>&1 && return 0
	setsid /bin/sh /opt/bench/throttled.sh >/dev/null 2>&1 &
}

stop() {
	# busybox has pgrep but not pkill; bracket avoids matching the pgrep itself
	for pid in $(pgrep -f '[t]hrottled.sh'); do kill "$pid" 2>/dev/null; done
	return 0
}
